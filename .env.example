# Safe template only. Keep real values in local `.env.local` for development and in Vercel Environment Variables for deployed environments.
# Never commit live API keys, Gist tokens, or any `VITE_*` secret variables.
TAVILY_API_KEY=your_tavily_api_key
BRAVE_API_KEY=your_brave_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GIST_ID=your_gist_id
GITHUB_GIST_TOKEN=your_github_gist_token
GIST_CUSTOMER_DATA_FILENAME=customer-data.json

# Optional future persistence
DATABASE_URL=your_optional_database_url
