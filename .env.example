# Safe template only. Keep real values in local `.env.local` for development and in Vercel Environment Variables for deployed environments.
# Never commit live API keys, Gist tokens, or any `VITE_*` secret variables.
TAVILY_API_KEY=your_tavily_api_key
TAVILY_API_KEY_BACKUP=your_backup_tavily_api_key
BRAVE_API_KEY=your_brave_api_key
BRAVE_API_KEY_BACKUP=your_backup_brave_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GIST_ID=your_gist_id
GITHUB_GIST_TOKEN=your_github_gist_token
GIST_CUSTOMER_DATA_FILENAME=customer-data.json

# AI proxy / relay. Configure real values in Vercel Environment Variables, never in GitHub.
AI_API_HOST=https://your-ai-proxy.example.com/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=your_model_name
AI_PROVIDER=openai-compatible
AI_REASONING_EFFORT=max
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=3000

# API cost controls. These are server-side soft daily limits before provider calls.
API_CACHE_TTL_HOURS=24
API_DAILY_TAVILY_LIMIT=80
API_DAILY_BRAVE_LIMIT=80
API_DAILY_GOOGLE_MAPS_LIMIT=200
API_DAILY_AI_LIMIT=100

# Optional future persistence
DATABASE_URL=your_optional_database_url
